<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Colocamos el botón en la cabecera (statusbar) al lado de Enviar por Correo -->
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" 
                        string="Enviar por WhatsApp" 
                        type="object" 
                        class="btn-success" 
                        icon="fa-whatsapp"
                        invisible="state not in ['draft', 'sent', 'sale']"/>
            </xpath>
        </field>
    </record>
</odoo>
