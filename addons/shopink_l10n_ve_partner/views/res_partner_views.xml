<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form_inherit_l10n_ve" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.l10n.ve</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Posicionamos los campos fiscales venezolanos justo antes del campo nativo vat -->
                <xpath expr="//field[@name='vat']" position="before">
                    <field name="l10n_ve_person_type" widget="radio" options="{'horizontal': true}" class="oe_inline"/>
                    <field name="l10n_ve_rif" placeholder="Ej: J-40068331-9" string="RIF / Cédula (VE)"/>
                    <field name="l10n_ve_taxpayer_type" widget="priority" string="Tipo Contribuyente"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
