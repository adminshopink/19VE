<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_commercial_report_wizard" model="ir.ui.view">
        <field name="name">sale.commercial.report.wizard.form</field>
        <field name="model">sale.commercial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Pagos Comerciales">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="user_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Generar Reporte" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_commercial_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Pagos</field>
        <field name="res_model">sale.commercial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
