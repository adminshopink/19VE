<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de Lista (Ajustada a la etiqueta list de Odoo 19) -->
        <record id="view_l10n_ve_islr_concept_tree" model="ir.ui.view">
            <field name="name">l10n_ve.islr.concept.list</field>
            <field name="model">l10n_ve.islr.concept</field>
            <field name="arch" type="xml">
                <list string="Conceptos de Retención de ISLR">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="person_type"/>
                    <field name="withholding_percentage"/>
                    <field name="subtracting_ut"/>
                </list>
            </field>
        </record>

        <!-- Vista de Formulario -->
        <record id="view_l10n_ve_islr_concept_form" model="ir.ui.view">
            <field name="name">l10n_ve.islr.concept.form</field>
            <field name="model">l10n_ve.islr.concept</field>
            <field name="arch" type="xml">
                <form string="Concepto de Retención de ISLR">
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="person_type"/>
                            </group>
                            <group>
                                <field name="withholding_percentage"/>
                                <field name="subtracting_ut"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción de Ventana (Corregido el modelo y el view_mode) -->
        <record id="action_l10n_ve_islr_concept" model="ir.actions.act_window">
            <field name="name">Conceptos de ISLR (VE)</field>
            <field name="res_model">l10n_ve.islr.concept</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea el primer concepto de retención de ISLR según el clasificador del SENIAT.
                </p>
            </field>
        </record>

        <!-- Menús (Colgados directamente del submenú de Impuestos en Contabilidad) -->
        <menuitem id="menu_l10n_ve_islr_concept"
                  name="Conceptos de ISLR (VE)"
                  parent="account.menu_action_tax_form"
                  action="action_l10n_ve_islr_concept"
                  sequence="25"/>
    </data>
</odoo>
