<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Heredamos el formulario nativo de facturas -->
        <record id="view_move_form_inherit_l10n_ve_withholding" model="ir.ui.view">
            <field name="name">account.move.form.inherit.l10n.ve.withholding</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- 1. Agregamos el switch de retención en la sección superior -->
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="l10n_ve_apply_withholding"/>
                </xpath>

                <!-- 2. Agregamos la pestaña dedicada a las Retenciones Fiscales (VE) -->
                <xpath expr="//page[@name='other_info']" position="before">
                    <page string="Retenciones Fiscales (VE)" invisible="not l10n_ve_apply_withholding">
                        <group string="Configuración del Asiento de Cierre">
                            <group>
                                <field name="l10n_ve_bridge_journal_id" required="l10n_ve_apply_withholding"/>
                            </group>
                        </group>
                        <group>
                            <!-- Sección IVA: Aplica para Clientes -->
                            <group string="Retención de IVA Recibida (Clientes)" invisible="move_type != 'out_invoice'">
                                <field name="l10n_ve_iva_holding_number"/>
                                <field name="l10n_ve_iva_holding_date"/>
                                <field name="l10n_ve_iva_amount_retained"/>
                                <field name="l10n_ve_iva_bridge_move_id"/>
                            </group>
                            
                            <!-- Sección ISLR: Resumen y cálculo automático -->
                            <group string="Retención de ISLR">
                                <field name="l10n_ve_islr_withholding_number" placeholder="Ej: 20260717..."/>
                                <field name="l10n_ve_islr_amount_retained"/>
                            </group>
                        </group>
                    </page>
                </xpath>

                <!-- 3. Inyectamos la columna del Concepto de ISLR apuntando al tag list real de Odoo 19 -->
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="after">
                    <field name="l10n_ve_islr_concept_id" 
                           optional="show" 
                           column_invisible="parent.move_type != 'in_invoice' or not parent.l10n_ve_apply_withholding"
                           options="{'no_create': True, 'no_edit': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
